# Copie para .env.local. Em producao (Vercel), cadastre as variaveis em Settings > Environment Variables.

# Login da tela /admin
ADMIN_USER=
ADMIN_PASSWORD=

# Postgres. Local: docker compose up -d. Producao: a URL com pooler do banco gerenciado.
DATABASE_URL=postgres://adsclicker:adsclicker@localhost:5439/adsclicker

# Sal do hash de IP usado nos limites de taxa (qualquer texto aleatorio longo)
IP_HASH_SALT=

# Geracao de arte pela API de imagens da OpenAI (npm run art:generate). Opcional.
OPENAI_API_KEY=
